<?xml version="1.0"?>
<model>
  <name>AscTec Hummingbird</name>
  <version>1.0</version>
  <sdf version="1.6">hummingbird.sdf.jinja</sdf>
  <author>
    <name>Fadri Furrer, ETH ASL RotorS</name>
  </author>
  <description>
    AscTec Hummingbird for PX4 Gazebo Classic SITL. Body mesh, mass, arm length,
    and rotor layout are from PX4/rotors_simulator rotors_description (ASL 2.0).
    Motor and MAVLink plugins are the PX4 sitl_gazebo-classic iris plugins.
  </description>
</model>
